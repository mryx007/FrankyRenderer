msgstr "Mitternacht"

#. Choice (General > Menu Appearance > Theme)
msgid "Ocean"
msgstr "Ozean"

#. Choice (General > Menu Appearance > Theme)
msgid "Light"
msgstr "Hell"

#. Setting name (General > Menu Appearance)
msgid "Accent Color"
msgstr "Akzentfarbe"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Violet"
msgstr "Violett"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Blue"
msgstr "Blau"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Teal"
msgstr "Türkis"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Green"
msgstr "Grün"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Orange"
