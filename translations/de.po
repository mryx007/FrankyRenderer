#. Choice (General > Menu Appearance > Accent Color)
msgid "Pink"
msgstr "Rosa"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Windows"
msgstr "Windows"

#. Setting name (General > Menu Appearance)
msgid "Language"
msgstr "Sprache"

#. Setting description (General > Menu Appearance > Language)
msgid ""
"Language of this settings window. Automatic follows Windows; missing "
"translations show English."
msgstr ""
"Sprache dieses Einstellungsfensters. Automatisch folgt Windows; fehlende "
"Übersetzungen werden auf Englisch angezeigt."

#. Choice (General > Menu Appearance > Language)
#. Menu text; keep %d and %s placeholders
msgid "Automatic (Windows)"
msgstr "Automatisch (Windows)"

#. Choice (General > Menu Appearance > Language)
#. Menu text; keep %d and %s placeholders
msgid "English"
msgstr "Englisch"

#. Category
#. Category heading
msgid "Processing"
msgstr "Verarbeitung"

#. Category description
msgid "Image cleanup, field processing, dithering and black bar handling."
msgstr ""
"Bildverbesserung, Halbbildverarbeitung, Dithering und Behandlung schwarzer "
"Balken."

#. Tab (Processing)
msgid "Image Cleanup"
msgstr "Bildverbesserung"

#. Tab (Processing)
msgid "Deinterlacing & Dithering"
msgstr "Deinterlacing und Dithering"

#. Tab (Processing)
msgid "Black Bars / Zoom"
msgstr "Schwarze Balken / Zoom"

#. Section heading (Processing)
#. Setting name (Processing > Debanding)
msgid "Debanding"
msgstr "Debanding"

#. Setting description (Processing > Debanding > Debanding)
msgid ""
"Reduce visible steps in smooth gradients. Excessive settings can remove fine "
"detail."
msgstr ""
"Verringert sichtbare Abstufungen in weichen Farbverläufen. Zu starke "
"Einstellungen können feine Details entfernen."

#. Setting name (Processing > Debanding)
msgid "Iterations"
msgstr "Durchläufe"

#. Setting description (Processing > Debanding > Iterations)
msgid "More iterations remove stronger banding; may lose detail."
msgstr ""
"Mehr Durchläufe entfernen stärkere Farbabstufungen, können aber Details "
"verlieren lassen."

#. Setting name (Processing > Debanding)
msgid "Threshold"
msgstr "Schwellenwert"

#. Setting description (Processing > Debanding > Threshold)
msgid "Difference threshold for detecting banding."
msgstr ""
"Schwellenwert für Farbunterschiede bei der Erkennung von Farbabstufungen."

#. Setting name (Processing > Debanding)
#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
msgid "Radius"
msgstr "Radius"

#. Setting description (Processing > Debanding > Radius)
msgid "Search radius in pixels."
msgstr "Suchradius in Pixeln."

#. Setting name (Processing > Debanding)
msgid "Grain"
msgstr "Körnung"

#. Setting description (Processing > Debanding > Grain)
msgid "Grain added after debanding."
msgstr "Nach dem Debanding hinzugefügte Körnung."

#. Section heading (Processing)
msgid "Adaptive Sharpen"
msgstr "Adaptives Nachschärfen"

#. Setting name (Processing > Adaptive Sharpen)
msgid "Enhance Edges and Details"
msgstr "Kanten und Details verstärken"

#. Setting description (Processing > Adaptive Sharpen > Enhance Edges and Details)
msgid "Apply adaptive sharpening with built-in anti-ringing."
msgstr ""
"Adaptives Nachschärfen mit integrierter Unterdrückung von Artefakten durch "
"Ringing anwenden."

#. Setting name (Processing > Adaptive Sharpen)
msgid "Strength"
msgstr "Stärke"

#. Setting description (Processing > Adaptive Sharpen > Strength)
msgid "Amount of adaptive sharpening. 0 disables the sharpening effect."
msgstr ""
"Stärke des adaptiven Nachschärfens. 0 deaktiviert den Schärfungseffekt."

#. Section heading (Processing)
msgid "Deinterlacing"
msgstr "Deinterlacing"

#. Setting name (Processing > Deinterlacing)
#. Setting name (Processing > Dithering)
msgid "Algorithm"
msgstr "Algorithmus"

#. Setting description (Processing > Deinterlacing > Algorithm)
#. Setting description (Processing > Dithering > Algorithm)
msgid "Choose the processing method. Off bypasses this processing stage."
msgstr ""
"Verarbeitungsmethode auswählen. Aus überspringt diesen Verarbeitungsschritt."

#. Choice (Processing > Deinterlacing > Algorithm)
msgid "Bwdif"
msgstr "Bwdif"

#. Choice (Processing > Deinterlacing > Algorithm)
msgid "Yadif"
msgstr "Yadif"

#. Setting name (Processing > Deinterlacing)
msgid "Field Order"
msgstr "Halbbildreihenfolge"

#. Setting description (Processing > Deinterlacing > Field Order)
msgid ""
"Auto follows source flags. Override only if interlaced motion has the wrong "
"field order."
msgstr ""
"Automatisch folgt den Kennzeichnungen der Quelle. Nur überschreiben, wenn "
"Bewegungen in Material mit Zeilensprung die falsche Halbbildreihenfolge "
"haben."

#. Choice (Processing > Deinterlacing > Field Order)
msgid "Auto (Source Flags)"
msgstr "Automatisch (Quellkennzeichnungen)"

#. Choice (Processing > Deinterlacing > Field Order)
msgid "Top Field First"
msgstr "Oberes Halbbild zuerst"

#. Choice (Processing > Deinterlacing > Field Order)
msgid "Bottom Field First"
msgstr "Unteres Halbbild zuerst"

#. Section heading (Processing)
msgid "Dithering"
msgstr "Dithering"

#. Choice (Processing > Dithering > Algorithm)
msgid "Blue Noise (recommended)"
msgstr "Blaues Rauschen (empfohlen)"

#. Choice (Processing > Dithering > Algorithm)
msgid "Ordered Dithering"
msgstr "Geordnetes Dithering"

#. Choice (Processing > Dithering > Algorithm)
msgid "Random Dithering"
msgstr "Zufälliges Dithering"

#. Setting name (Processing > Dithering)
msgid "Change Dither for Every Frame"
msgstr "Dithermuster bei jedem Bild ändern"

#. Setting description (Processing > Dithering > Change Dither for Every Frame)
msgid "Vary the dither pattern over time instead of keeping a static pattern."
msgstr ""
"Verändert das Dithermuster mit der Zeit, statt ein festes Muster "
"beizubehalten."

#. Section heading (Processing)
msgid "Detection & Zoom"
msgstr "Erkennung und Zoom"

#. Setting name (Processing > Detection & Zoom)
msgid "Detect Hardcoded Black Bars"
msgstr "Im Video enthaltene schwarze Balken erkennen"

#. Setting description (Processing > Detection & Zoom > Detect Hardcoded Black Bars)
msgid "Analyze decoded pixels to find bars encoded into the video."
msgstr ""
"Analysiert decodierte Pixel, um Balken zu finden, die Teil des Videos sind."

#. Setting name (Processing > Detection & Zoom)
msgid "Crop Black Bars"
msgstr "Schwarze Balken abschneiden"

#. Setting description (Processing > Detection & Zoom > Crop Black Bars)
msgid ""
"Remove detected bars from the active image before fitting or zooming it."
msgstr ""
"Entfernt erkannte Balken aus dem aktiven Bild, bevor es eingepasst oder "
"vergrößert wird."

#. Setting name (Processing > Detection & Zoom)
msgid "Protect Burned-in Subtitles"
msgstr "Eingebrannte Untertitel schützen"

#. Setting description (Processing > Detection & Zoom > Protect Burned-in Subtitles)
msgid "Temporarily restore bars if they contain visible content."
msgstr ""
"Stellt Balken vorübergehend wieder her, wenn sie sichtbaren Inhalt enthalten."

#. Setting name (Processing > Detection & Zoom)
msgid "Keep a Stable Zoom"
msgstr "Zoom stabil halten"

#. Setting description (Processing > Detection & Zoom > Keep a Stable Zoom)
msgid ""
"Prefer a common zoom that preserves content when the detected active area "
"changes."
msgstr ""
"Bevorzugt einen einheitlichen Zoom, der den Inhalt erhält, wenn sich der "
"erkannte aktive Bildbereich ändert."

#. Setting name (Processing > Detection & Zoom)
msgid "Zoom Mode"
msgstr "Zoommodus"

#. Setting description (Processing > Detection & Zoom > Zoom Mode)
msgid ""
"Fit keeps all active content. Fill covers the output and can crop image "
"content."
msgstr ""
"Einpassen erhält den gesamten aktiven Inhalt. Ausfüllen bedeckt die "
"Ausgabefläche und kann Bildinhalte abschneiden."

#. Choice (Processing > Detection & Zoom > Zoom Mode)
msgid "Fit (Keep All Content)"
msgstr "Einpassen (gesamten Inhalt erhalten)"

#. Choice (Processing > Detection & Zoom > Zoom Mode)
msgid "Fill (May Crop Content)"
msgstr "Ausfüllen (kann Inhalt abschneiden)"

#. Setting name (Processing > Detection & Zoom)
msgid "Black Threshold"
msgstr "Schwarzschwelle"

#. Setting description (Processing > Detection & Zoom > Black Threshold)
msgid "Maximum detected bar brightness, as a percentage of decoded SDR white."
msgstr ""
"Maximale Helligkeit erkannter Balken als Prozentsatz des decodierten "
"Weißwerts in SDR."

#. Setting name (Processing > Detection & Zoom)
msgid "Detection Stability (seconds)"
msgstr "Erkennungsstabilität (Sekunden)"

#. Setting description (Processing > Detection & Zoom > Detection Stability (seconds))
msgid "Time required for a new detected bar layout to become stable."
msgstr "Zeit, nach der eine neu erkannte Balkenanordnung als stabil gilt."

#. Category
#. Category heading
msgid "Scaling"
msgstr "Skalierung"

#. Category description
msgid ""
"Built-in scaling filters, RTX Video Super Resolution and custom filters."
msgstr ""
"Integrierte Skalierungsfilter, RTX Video Super Resolution und "
"benutzerdefinierte Filter."

#. Tab (Scaling)
#. Section heading (Scaling)
msgid "Filters"
msgstr "Filter"

#. Tab (Scaling)
msgid "Custom Filters"
msgstr "Benutzerdefinierte Filter"

#. Setting name (Scaling > Filters)
#. Choice (Scaling > Custom Filter Role > Role)
msgid "Image Upscaler"
msgstr "Hochskalierung des Bildes"

#. Setting description (Scaling > Filters > Image Upscaler)
msgid ""
"Reconstruct image detail when enlarging video. Custom copies the selected "
"filter for editing."
msgstr ""
"Rekonstruiert Bilddetails beim Vergrößern des Videos. Benutzerdefiniert "
"übernimmt den ausgewählten Filter zur Bearbeitung."

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Use the renderer's default filter."
msgstr "Den Standardfilter des Renderers verwenden."

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "No filter, only use basic GPU texture sampling"
msgstr "Kein Filter, nur einfache Texturabtastung durch die GPU"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Configure a custom filter using the controls below."
msgstr ""
"Einen benutzerdefinierten Filter mit den folgenden Einstellungen "
"konfigurieren."

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "Nearest-neighbour (box) sampling (very fast)"
msgstr "Nächster Nachbar mit Box-Abtastung (sehr schnell)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "Bilinear sampling (very fast)"
msgstr "Bilineare Abtastung (sehr schnell)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "Aspect-ratio preserving nearest neighbour sampling (very fast)"
msgstr ""
"Abtastung nach nächstem Nachbarn mit Erhalt des Seitenverhältnisses (sehr "
"schnell)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Bicubic interpolation (fast)"
msgstr "Bikubische Interpolation (schnell)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Gaussian smoothing (fast)"
msgstr "Gaußsche Glättung (schnell)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Catmull-Rom cubic spline"
msgstr "Kubischer Spline nach Catmull-Rom"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Lanczos reconstruction"
msgstr "Rekonstruktion mit Lanczos"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "EWA Lanczos (Jinc) reconstruction (slow)"
msgstr "Rekonstruktion mit EWA Lanczos (Jinc, langsam)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "Sharpened version of ewa_lanczos (slow)"
msgstr "Geschärfte Variante von ewa_lanczos (langsam)"

#. Choice description (Scaling > Filters > Image Upscaler)
#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Upscaler > Starting Filter)
msgid "Very sharp version of ewa_lanczos, with anti-ringing (very slow)"
msgstr ""
"Sehr scharfe Variante von ewa_lanczos mit Unterdrückung von Ringing (sehr "
"langsam)"

#. Setting name (Scaling > Filters)
#. Choice (Scaling > Custom Filter Role > Role)
msgid "Image Downscaler"
msgstr "Verkleinerung des Bildes"

#. Setting description (Scaling > Filters > Image Downscaler)
msgid ""
"Filter the image when reducing video size. Custom copies the selected filter "
"for editing."
msgstr ""
"Filtert das Bild beim Verkleinern des Videos. Benutzerdefiniert übernimmt "
"den ausgewählten Filter zur Bearbeitung."

#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Custom: Image Downscaler > Starting Filter)
msgid "Use the same filter as specified for upscaler"
msgstr "Denselben Filter wie beim Hochskalieren verwenden"

#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Downscaler > Starting Filter)
msgid "Box averaging (very fast)"
msgstr "Mittelung mit Box-Filter (sehr schnell)"

#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Downscaler > Starting Filter)
msgid "Hermite-weighted averaging (fast)"
msgstr "Nach Hermite gewichtete Mittelung (schnell)"

#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Downscaler > Starting Filter)
msgid "Bilinear (triangle) averaging (fast)"
msgstr "Bilineare Mittelung (Dreiecksfilter, schnell)"

#. Choice description (Scaling > Filters > Image Downscaler)
#. Choice description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Image Downscaler > Starting Filter)
msgid "Mitchell-Netravalia cubic spline"
msgstr "Kubischer Spline nach Mitchell-Netravalia"

#. Setting name (Scaling > Filters)
#. Choice (Scaling > Custom Filter Role > Role)
msgid "Plane Upscaler (Chroma / Alpha)"
msgstr "Hochskalierung der Ebenen (Chroma / Alpha)"

#. Setting description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
msgid "Reconstruct subsampled chroma or alpha planes before image scaling."
msgstr ""
"Rekonstruiert unterabgetastete Ebenen für Chroma oder Alpha vor der "
"Bildskalierung."

#. Choice description (Scaling > Filters > Plane Upscaler (Chroma / Alpha))
#. Choice description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
#. Choice description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Starting Filter)
msgid "Use the corresponding image scaling filter."
msgstr "Den entsprechenden Bildskalierungsfilter verwenden."

#. Setting name (Scaling > Filters)
#. Choice (Scaling > Custom Filter Role > Role)
msgid "Plane Downscaler (Chroma / Alpha)"
msgstr "Verkleinerung der Ebenen (Chroma / Alpha)"

#. Setting description (Scaling > Filters > Plane Downscaler (Chroma / Alpha))
msgid "Filter chroma or alpha planes when reducing their resolution."
msgstr ""
"Filtert die Ebenen für Chroma oder Alpha beim Verringern ihrer Auflösung."

#. Setting name (Scaling > Filters)
#. Choice (Scaling > Custom Filter Role > Role)
msgid "Frame Mixer"
msgstr "Bildmischer"

#. Setting description (Scaling > Filters > Frame Mixer)
msgid ""
"Temporal filter used by Smooth Motion. It combines frames rather than adding "
"image detail."
msgstr ""
"Zeitlicher Filter für Smooth Motion. Kombiniert Bilder, statt Bilddetails "
"hinzuzufügen."

#. Choice description (Scaling > Filters > Frame Mixer)
#. Choice description (Scaling > Custom: Frame Mixer > Starting Filter)
msgid "Disable frame mixing, show nearest frame to target PTS"
msgstr ""
"Bildmischung deaktivieren; das Bild mit dem nächstgelegenen Zielzeitstempel "
"anzeigen"

#. Choice description (Scaling > Filters > Frame Mixer)
#. Choice description (Scaling > Custom: Frame Mixer > Starting Filter)
msgid "Oversampling, only mix edge frames while preserving FPS"
msgstr "Oversampling; nur Randbilder mischen und die Bildrate beibehalten"

#. Choice description (Scaling > Filters > Frame Mixer)
#. Choice description (Scaling > Custom: Frame Mixer > Starting Filter)
msgid "Hermite-weighted frame mixing"
msgstr "Nach Hermite gewichtete Bildmischung"

#. Choice description (Scaling > Filters > Frame Mixer)
#. Choice description (Scaling > Custom: Frame Mixer > Starting Filter)
msgid "Linear frame mixing"
msgstr "Lineare Bildmischung"

#. Choice description (Scaling > Filters > Frame Mixer)
#. Choice description (Scaling > Custom: Frame Mixer > Starting Filter)
msgid "Cubic B-spline frame mixing"
msgstr "Bildmischung mit kubischem B-Spline"

#. Setting name (Scaling > Filters)
msgid "Global Anti-Ringing"
msgstr "Globale Unterdrückung von Ringing"

#. Setting description (Scaling > Filters > Global Anti-Ringing)
msgid "Suppress overshoot around edges."
msgstr "Unterdrückt Überschwinger an Kanten."

#. Setting name (Scaling > Filters)
msgid "Enable Smooth Motion"
msgstr "Smooth Motion aktivieren"

#. Setting description (Scaling > Filters > Enable Smooth Motion)
msgid ""
"Blend video frames to reduce judder when video and display refresh rates "
"differ."
msgstr ""
"Mischt Videobilder, um Ruckeln bei unterschiedlichen Video- und "
"Bildschirmbildraten zu verringern."

#. Setting name (Scaling > Filters)
msgid "Present in Advance"
msgstr "Bilder im Voraus ausgeben"

#. Setting description (Scaling > Filters > Present in Advance)
msgid ""
"Smooth Motion pictures handed to the display ahead of time. More absorbs "
"render peaks on slower PCs but adds latency. Automatic starts at one and "
"adds more only after late pictures."
msgstr ""
"Anzahl der Bilder, die Smooth Motion vorab an den Bildschirm übergibt. Mehr "
"Bilder puffern Renderzeitspitzen auf langsameren PCs ab, erhöhen aber die "
"Latenz. Automatisch beginnt mit einem Bild und erhöht die Anzahl nur nach "
"verspäteten Bildern."

#. Choice (Scaling > Filters > Present in Advance)
msgid "Automatic"
msgstr "Automatisch"

#. Choice (Scaling > Filters > Present in Advance)
msgid "1 Refresh"
msgstr "1 Bildwiederholung"

#. Choice (Scaling > Filters > Present in Advance)
msgid "2 Refreshes"
msgstr "2 Bildwiederholungen"

#. Choice (Scaling > Filters > Present in Advance)
msgid "3 Refreshes"
msgstr "3 Bildwiederholungen"

#. Choice (Scaling > Filters > Present in Advance)
msgid "4 Refreshes"
msgstr "4 Bildwiederholungen"

#. Setting name (Scaling > Filters)
msgid "Oversample Threshold"
msgstr "Schwellenwert für Oversampling"

#. Setting description (Scaling > Filters > Oversample Threshold)
msgid ""
"Smooth Motion shows a whole picture instead of a blend when the other "
"picture would cover less than this share of a refresh. Fewer double edges on "
"motion; 0 always blends. Used with the oversample frame mixer."
msgstr ""
"Smooth Motion zeigt ein vollständiges Bild statt einer Mischung, wenn das "
"andere Bild weniger als diesen Anteil einer Bildwiederholung abdecken würde. "
"Verringert doppelte Kanten bei Bewegung. 0 mischt immer. Wird mit dem "
"Bildmischer im Modus Oversampling verwendet."

#. Setting name (Scaling > Filters)
msgid "Skip Downscale Anti-Aliasing"
msgstr "Kantenglättung beim Herunterskalieren überspringen"

#. Setting description (Scaling > Filters > Skip Downscale Anti-Aliasing)
msgid ""
"Faster downscaling by skipping anti-aliasing. Can introduce moire and jagged "
"edges. Default: Off; leave Off for best quality."
msgstr ""
"Beschleunigt das Herunterskalieren durch Auslassen der Kantenglättung. Kann "
"Moiré und gezackte Kanten verursachen. Standard: Aus; für die beste Qualität "
"ausgeschaltet lassen."

#. Setting name (Scaling > Filters)
msgid "Preserve Frame Mixer Cache"
msgstr "Zwischenspeicher des Bildmischers beibehalten"

#. Setting description (Scaling > Filters > Preserve Frame Mixer Cache)
msgid ""
"Reuse mixed frames after resizing or parameter changes. May make transitions "
"smoother but briefly reuse lower-quality or older processing. Default: Off; "
"used with Smooth Motion."
msgstr ""
"Verwendet gemischte Bilder nach Größen- oder Parameteränderungen erneut. "
"Kann Übergänge glätten, aber kurzzeitig Bilder geringerer Qualität oder aus "
"einer älteren Verarbeitung wiederverwenden. Standard: Aus; wird mit Smooth "
"Motion verwendet."

#. Section heading (Scaling)
#. Setting name (Scaling > RTX Video Super Resolution)
msgid "RTX Video Super Resolution"
msgstr "RTX Video Super Resolution"

#. Section description (Scaling > RTX Video Super Resolution)
msgid "Enable Super Resolution in the NVIDIA app first. Quality is set there."
msgstr ""
"Super Resolution zuerst in der NVIDIA App aktivieren. Die Qualität wird dort "
"eingestellt."

#. Setting description (Scaling > RTX Video Super Resolution > RTX Video Super Resolution)
msgid ""
"Request AI upscaling through the NVIDIA driver. Requires Super Resolution "
"enabled in the NVIDIA app."
msgstr ""
"Fordert Hochskalierung mit KI über den Grafiktreiber von NVIDIA an. Super "
"Resolution muss in der NVIDIA App aktiviert sein."

#. Section heading (Scaling)
msgid "Custom Filter Role"
msgstr "Anwendungsbereich des benutzerdefinierten Filters"

#. Section description (Scaling > Custom Filter Role)
msgid "The custom filter settings below apply to the selected scaler role."
msgstr ""
"Die folgenden benutzerdefinierten Filtereinstellungen gelten für den "
"ausgewählten Skalierungsbereich."

#. Setting name (Scaling > Custom Filter Role)
msgid "Role"
msgstr "Anwendungsbereich"

#. Setting description (Scaling > Custom Filter Role > Role)
msgid "Scaler role whose custom filter is edited."
msgstr "Skalierungsbereich, dessen benutzerdefinierter Filter bearbeitet wird."

#. Section heading (Scaling)
msgid "Custom: Image Upscaler"
msgstr "Benutzerdefiniert: Hochskalierung des Bildes"

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Enable Custom Settings"
msgstr "Benutzerdefinierte Einstellungen aktivieren"

#. Setting description (Scaling > Custom: Image Upscaler > Enable Custom Settings)
#. Setting description (Scaling > Custom: Image Downscaler > Enable Custom Settings)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Enable Custom Settings)
msgid "Use custom filter settings based on the starting filter."
msgstr ""
"Benutzerdefinierte Filtereinstellungen auf Grundlage des Ausgangsfilters "
"verwenden."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Starting Filter"
msgstr "Ausgangsfilter"

#. Setting description (Scaling > Custom: Image Upscaler > Starting Filter)
#. Setting description (Scaling > Custom: Image Downscaler > Starting Filter)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Starting Filter)
msgid ""
"Base preset for this custom filter. Its values are inherited until you "
"change a parameter."
msgstr ""
"Basisvorlage für diesen benutzerdefinierten Filter. Ihre Werte werden "
"übernommen, bis ein Parameter geändert wird."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Kernel"
msgstr "Filterkern"

#. Setting description (Scaling > Custom: Image Upscaler > Kernel)
#. Setting description (Scaling > Custom: Image Downscaler > Kernel)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Kernel)
msgid "Reconstruction function. Auto inherits the starting filter's kernel."
msgstr ""
"Rekonstruktionsfunktion. Automatisch übernimmt den Filterkern des "
"Ausgangsfilters."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Window"
msgstr "Fensterfunktion"

#. Setting description (Scaling > Custom: Image Upscaler > Window)
#. Setting description (Scaling > Custom: Image Downscaler > Window)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Window)
msgid "Window applied to the kernel. Auto inherits it; None removes windowing."
msgstr ""
"Auf den Filterkern angewendete Fensterfunktion. Automatisch übernimmt sie; "
"Keine entfernt sie."

#. Setting description (Scaling > Custom: Image Upscaler > Radius)
#. Setting description (Scaling > Custom: Image Downscaler > Radius)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Radius)
msgid ""
"Kernel support radius. Available only for resizable kernels; larger radii "
"sample more pixels."
msgstr ""
"Stützradius des Filterkerns. Nur für größenveränderliche Filterkerne "
"verfügbar. Größere Radien tasten mehr Pixel ab."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Clamp"
msgstr "Begrenzung"

#. Setting description (Scaling > Custom: Image Upscaler > Clamp)
#. Setting description (Scaling > Custom: Image Downscaler > Clamp)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Clamp)
msgid ""
"Suppress negative filter weights to reduce ringing. Higher values soften the "
"result."
msgstr ""
"Unterdrückt negative Filtergewichte, um Ringing zu verringern. Höhere Werte "
"machen das Ergebnis weicher."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Blur"
msgstr "Unschärfe"

#. Setting description (Scaling > Custom: Image Upscaler > Blur)
#. Setting description (Scaling > Custom: Image Downscaler > Blur)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Blur)
msgid ""
"Filter width multiplier. Below 1 sharpens, above 1 softens; 0 uses the "
"filter default."
msgstr ""
"Multiplikator für die Filterbreite. Unter 1 wird das Bild schärfer, über 1 "
"weicher. 0 verwendet den Standardwert des Filters."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Taper"
msgstr "Abflachung"

#. Setting description (Scaling > Custom: Image Upscaler > Taper)
#. Setting description (Scaling > Custom: Image Downscaler > Taper)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Taper)
msgid "Flatten the center of the reconstruction kernel."
msgstr "Flacht das Zentrum des Rekonstruktionskerns ab."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Anti-Ringing"
msgstr "Unterdrückung von Ringing"

#. Setting description (Scaling > Custom: Image Upscaler > Anti-Ringing)
#. Setting description (Scaling > Custom: Image Downscaler > Anti-Ringing)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Anti-Ringing)
msgid ""
"Suppress overshoot for this filter. Zero inherits the global anti-ringing "
"strength."
msgstr ""
"Unterdrückt Überschwinger für diesen Filter. 0 übernimmt die globale Stärke "
"der Unterdrückung von Ringing."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Kernel Parameter 1"
msgstr "Filterkernparameter 1"

#. Setting description (Scaling > Custom: Image Upscaler > Kernel Parameter 1)
#. Setting description (Scaling > Custom: Image Downscaler > Kernel Parameter 1)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Kernel Parameter 1)
msgid ""
"First kernel-specific parameter. Available only when the selected kernel "
"supports it."
msgstr ""
"Erster filterspezifischer Parameter. Nur verfügbar, wenn der ausgewählte "
"Filterkern ihn unterstützt."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Kernel Parameter 2"
msgstr "Filterkernparameter 2"

#. Setting description (Scaling > Custom: Image Upscaler > Kernel Parameter 2)
#. Setting description (Scaling > Custom: Image Downscaler > Kernel Parameter 2)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Kernel Parameter 2)
msgid ""
"Second kernel-specific parameter. Available only when the selected kernel "
"supports it."
msgstr ""
"Zweiter filterspezifischer Parameter. Nur verfügbar, wenn der ausgewählte "
"Filterkern ihn unterstützt."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Window Parameter 1"
msgstr "Fensterparameter 1"

#. Setting description (Scaling > Custom: Image Upscaler > Window Parameter 1)
#. Setting description (Scaling > Custom: Image Downscaler > Window Parameter 1)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Window Parameter 1)
msgid ""
"First window-specific parameter. Available only when the selected window "
"supports it."
msgstr ""
"Erster fensterspezifischer Parameter. Nur verfügbar, wenn die ausgewählte "
"Fensterfunktion ihn unterstützt."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Window Parameter 2"
msgstr "Fensterparameter 2"

#. Setting description (Scaling > Custom: Image Upscaler > Window Parameter 2)
#. Setting description (Scaling > Custom: Image Downscaler > Window Parameter 2)
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Window Parameter 2)
msgid ""
"Second window-specific parameter. Available only when the selected window "
"supports it."
msgstr ""
"Zweiter fensterspezifischer Parameter. Nur verfügbar, wenn die ausgewählte "
"Fensterfunktion ihn unterstützt."

#. Setting name (Scaling > Custom: Image Upscaler)
#. Setting name (Scaling > Custom: Image Downscaler)
#. Setting name (Scaling > Custom: Plane Upscaler (Chroma / Alpha))
msgid "Polar (EWA)"
msgstr "Polar (EWA)"

#. Setting description (Scaling > Custom: Image Upscaler > Polar (EWA))
#. Setting description (Scaling > Custom: Image Downscaler > Polar (EWA))
#. Setting description (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Polar (EWA))
msgid ""
"Use a two-dimensional EWA filter. Frame mixers always remain one-dimensional."
msgstr ""
"Einen zweidimensionalen EWA-Filter verwenden. Bildmischer bleiben immer "
"eindimensional."

#. Choice (Scaling > Custom: Image Upscaler > Polar (EWA))
#. Choice (Scaling > Custom: Image Downscaler > Polar (EWA))
#. Choice (Scaling > Custom: Plane Upscaler (Chroma / Alpha) > Polar (EWA))
msgid "Inherit Starting Filter"
msgstr "Ausgangsfilter übernehmen"

#. Section heading (Scaling)
msgid "Custom: Image Downscaler"
msgstr "Benutzerdefiniert: Verkleinerung des Bildes"

#. Section heading (Scaling)
msgid "Custom: Plane Upscaler (Chroma / Alpha)"
msgstr "Benutzerdefiniert: Hochskalierung der Ebenen (Chroma / Alpha)"

#. Section heading (Scaling)
msgid "Custom: Plane Downscaler (Chroma / Alpha)"
msgstr "Benutzerdefiniert: Verkleinerung der Ebenen (Chroma / Alpha)"

#. Section heading (Scaling)
msgid "Custom: Frame Mixer"
msgstr "Benutzerdefiniert: Bildmischer"

#. Category
#. Category heading
msgid "Color"
msgstr "Farbe"

#. Category description
msgid "Picture controls and display calibration."
msgstr "Bildeinstellungen und Bildschirmkalibrierung."

#. Tab (Color)
#. Section heading (Color)
msgid "Picture Controls"
msgstr "Bildeinstellungen"

#. Tab (Color)
msgid "Calibration"
msgstr "Kalibrierung"

#. Setting name (Color > Picture Controls)
msgid "Enable Color Adjustment"
msgstr "Farbanpassung aktivieren"

#. Setting description (Color > Picture Controls > Enable Color Adjustment)
msgid ""
"Enable the picture controls in this section. Neutral values preserve the "
"original image."
msgstr ""
"Aktiviert die Bildeinstellungen in diesem Abschnitt. Neutrale Werte erhalten "
"das Originalbild."

#. Setting name (Color > Picture Controls)
msgid "Brightness"
msgstr "Helligkeit"

#. Setting description (Color > Picture Controls > Brightness)
msgid "Offset the picture's brightness. 0 preserves the original level."
msgstr "Verschiebt die Bildhelligkeit. 0 erhält den ursprünglichen Pegel."

#. Setting name (Color > Picture Controls)
#. Setting name (HDR > Shadows)
#. Setting name (HDR > Midtones)
msgid "Contrast"
msgstr "Kontrast"

#. Setting description (Color > Picture Controls > Contrast)
msgid "Scale the spread between dark and bright values. 1 is unchanged."
msgstr ""
"Skaliert den Abstand zwischen dunklen und hellen Werten. 1 lässt ihn "
"unverändert."

#. Setting name (Color > Picture Controls)
#. Choice (HDR > HDR Output > Gamut Mapping Function)
#. Setting name (HDR > Shadows)
msgid "Saturation"
msgstr "Sättigung"

#. Setting description (Color > Picture Controls > Saturation)
msgid ""
"Scale color intensity. 0 removes color; 1 preserves the original saturation."
msgstr ""
"Skaliert die Farbintensität. 0 entfernt die Farbe, 1 erhält die "
"ursprüngliche Sättigung."

#. Setting name (Color > Picture Controls)
#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Gamma"
msgstr "Gamma"

#. Setting description (Color > Picture Controls > Gamma)
msgid "Change the picture's tonal response. 1 preserves the original gamma."
msgstr ""
"Ändert die Tonwertwiedergabe des Bildes. 1 erhält das ursprüngliche Gamma."

#. Setting name (Color > Picture Controls)
msgid "Hue (degrees)"
msgstr "Farbton (Grad)"

#. Setting description (Color > Picture Controls > Hue (degrees))
msgid "Rotate chroma hue. 0 preserves the original colors."
msgstr ""
"Dreht den Farbton der Chromakanäle. 0 erhält die ursprünglichen Farben."

#. Setting name (Color > Picture Controls)
msgid "Temperature (K)"
msgstr "Farbtemperatur (K)"

#. Setting description (Color > Picture Controls > Temperature (K))
msgid ""
"Adjust white balance from warm to neutral. 6500 K preserves the original "
"white balance."
msgstr ""
"Passt den Weißabgleich von warm bis neutral an. 6500 K erhält den "
"ursprünglichen Weißabgleich."

#. Section heading (Color)
msgid "ICC Profile"
msgstr "ICC-Profil"

#. Setting name (Color > ICC Profile)
msgid "ICC Profile File"
msgstr "ICC-Profildatei"

#. Setting description (Color > ICC Profile > ICC Profile File)
msgid ""
"Select the display's ICC or ICM color profile before enabling ICC correction."
msgstr ""
"Vor dem Aktivieren der ICC-Korrektur das ICC- oder ICM-Farbprofil des "
"Bildschirms auswählen."

#. Button (Color > ICC Profile > ICC Profile File)
#. Button (Color > 3D LUT > LUT File)
msgid "Browse…"
msgstr "Durchsuchen…"

#. Setting name (Color > ICC Profile)
msgid "Enable ICC Profile"
msgstr "ICC-Profil aktivieren"

#. Setting description (Color > ICC Profile > Enable ICC Profile)
msgid "Apply color correction from the selected display profile."
msgstr "Wendet die Farbkorrektur aus dem ausgewählten Anzeigeprofil an."

#. Setting name (Color > ICC Profile)
msgid "ICC Rendering Intent"
msgstr "ICC-Wiedergabeabsicht"

#. Setting description (Color > ICC Profile > ICC Rendering Intent)
msgid "Choose how the ICC profile maps colors into the display's gamut."
msgstr ""
"Legt fest, wie das ICC-Profil Farben in den Farbumfang des Bildschirms "
"überführt."

#. Choice (Color > ICC Profile > ICC Rendering Intent)
#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Relative Colorimetric"
msgstr "Relativ farbmetrisch"

#. Choice (Color > ICC Profile > ICC Rendering Intent)
#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Perceptual"
msgstr "Wahrnehmungsorientiert"

#. Section heading (Color)
msgid "3D LUT"
msgstr "3D-LUT"

#. Setting name (Color > 3D LUT)
msgid "LUT File"
msgstr "LUT-Datei"

#. Setting description (Color > 3D LUT > LUT File)
msgid "Select a .cube 3D LUT before enabling LUT processing."
msgstr ""
"Vor dem Aktivieren der LUT-Verarbeitung eine 3D-LUT-Datei im Format .cube "
"auswählen."

#. Setting name (Color > 3D LUT)
msgid "Enable 3D LUT"
msgstr "3D-LUT aktivieren"

#. Setting description (Color > 3D LUT > Enable 3D LUT)
msgid "Apply the selected 3D LUT at the stage selected by LUT Type."
msgstr ""
"Wendet die ausgewählte 3D-LUT in dem Verarbeitungsschritt an, den der LUT-"
"Typ festlegt."

#. Setting name (Color > 3D LUT)
msgid "LUT Type"
msgstr "LUT-Typ"

#. Setting description (Color > 3D LUT > LUT Type)
msgid ""
"Default keeps the existing SDR calibration LUT stage. Manual types use this "
"file as a color-mapping LUT. Normalized uses linear-light RGB; Conversion "
"replaces color conversion, tone mapping and ICC correction. Match the LUT's "
"intended data representation."
msgstr ""
"Standard behält die bisherige LUT zur Kalibrierung von SDR bei. Manuelle "
"Typen verwenden diese Datei als LUT zur Farbumrechnung. Normalisiert "
"verwendet RGB in linearem Licht. Konvertierung ersetzt "
"Farbraumkonvertierung, Tone Mapping und die Korrektur mit dem ICC-Profil. "
"Der Typ muss zur vorgesehenen Datendarstellung der LUT passen."

#. Choice (Color > 3D LUT > LUT Type)
msgid "Default (SDR Calibration)"
msgstr "Standard (Kalibrierung für SDR)"

#. Choice (Color > 3D LUT > LUT Type)
msgid "Unknown"
msgstr "Unbekannt"

#. Choice (Color > 3D LUT > LUT Type)
msgid "Native"
msgstr "Nativ"

#. Choice (Color > 3D LUT > LUT Type)
msgid "Normalized"
msgstr "Normalisiert"

#. Choice (Color > 3D LUT > LUT Type)
msgid "Conversion"
msgstr "Konvertierung"

#. Category
#. Category heading
msgid "HDR"
msgstr "HDR"

#. Category description
msgid "HDR output, tone mapping, gamut mapping and tonal zones."
msgstr "Ausgabe von HDR, Tone Mapping, Gamut Mapping und Tonwertbereiche."

#. Tab (HDR)
msgid "Output & Peak Detection"
msgstr "Ausgabe und Spitzenhelligkeit"

#. Tab (HDR)
msgid "Tone Mapping"
msgstr "Tone Mapping"

#. Tab (HDR)
msgid "Gamut Mapping"
msgstr "Gamut Mapping"

#. Tab (HDR)
msgid "Tone Controls"
msgstr "Tonwertkorrektur"

#. Section heading (HDR)
msgid "HDR Output"
msgstr "Ausgabe von HDR"

#. Setting name (HDR > HDR Output)
msgid "HDR Mode"
msgstr "Modus für HDR"

#. Setting description (HDR > HDR Output > HDR Mode)
msgid ""
"Pass HDR and its metadata to the display; keep HDR output but roll off "
"highlights above the display's peak, for monitors and laptops that do not "
"tone map themselves; or tone map HDR to SDR."
msgstr ""
"HDR und seine Metadaten an den Bildschirm weitergeben; die Ausgabe von HDR "
"beibehalten, aber Spitzlichter oberhalb der Spitzenhelligkeit des "
"Bildschirms sanft absenken, für Monitore und Laptops ohne eigenes Tone "
"Mapping; oder HDR in SDR umrechnen."

#. Choice (HDR > HDR Output > HDR Mode)
msgid "Passthrough HDR to Display"
msgstr "HDR an den Bildschirm weitergeben"

#. Choice (HDR > HDR Output > HDR Mode)
msgid "Tone Map HDR to Display Peak"
msgstr "HDR an die Spitzenhelligkeit des Bildschirms anpassen"

#. Choice (HDR > HDR Output > HDR Mode)
msgid "Tone Map HDR to SDR"
msgstr "HDR in SDR umrechnen"

#. Setting name (HDR > HDR Output)
msgid "Clipping Protection"
msgstr "Schutz vor Übersteuerung"

#. Setting description (HDR > HDR Output > Clipping Protection)
msgid ""
"Automatically compress HDR highlights to the target peak. Bypassed during "
"HDR passthrough."
msgstr ""
"Komprimiert Spitzlichter in HDR automatisch auf die Zielspitzenhelligkeit. "
"Wird bei der Durchleitung von HDR umgangen."

#. Setting name (HDR > HDR Output)
msgid "HDR Target Peak (0 = Auto)"
msgstr "Zielspitzenhelligkeit für HDR (0 = automatisch)"

#. Setting description (HDR > HDR Output > HDR Target Peak (0 = Auto))
msgid ""
"Display peak for Tone Map HDR to Display Peak, in nits. 0 uses the peak "
"Windows reports for the display, which on some laptops follows the "
"brightness setting."
msgstr ""
"Spitzenhelligkeit des Bildschirms für die Anpassung von HDR an den "
"Bildschirm, in Nits. 0 verwendet den von Windows gemeldeten Wert, der bei "
"manchen Laptops von der Helligkeitseinstellung abhängt."

#. Setting name (HDR > HDR Output)
msgid "SDR Target Brightness (nits)"
msgstr "Zielhelligkeit für SDR (Nits)"

#. Setting description (HDR > HDR Output > SDR Target Brightness (nits))
msgid ""
"Target luminance for HDR-to-SDR tone mapping and the SDR reference white in "
"HDR output."
msgstr ""
"Zielleuchtdichte für die Umrechnung von HDR in SDR und das Referenzweiß für "
"SDR bei der Ausgabe von HDR."

#. Setting name (HDR > HDR Output)
msgid "Tone Mapping Function"
msgstr "Funktion für Tone Mapping"

#. Setting description (HDR > HDR Output > Tone Mapping Function)
msgid ""
"Compress source luminance into the output range. Algorithm-specific controls "
"appear below."
msgstr ""
"Komprimiert die Quellhelligkeit auf den Ausgabebereich. Darunter erscheinen "
"die Einstellungen des jeweiligen Algorithmus."

#. Choice (HDR > HDR Output > Tone Mapping Function)
#. Choice (HDR > Expansion & Metadata > Tone Mapping Metadata)
msgid "Auto (Metadata)"
msgstr "Automatisch (Metadaten)"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Spline"
msgstr "Spline"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "BT.2390"
msgstr "BT.2390"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "BT.2446A"
msgstr "BT.2446A"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Reinhard"
msgstr "Reinhard"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Mobius"
msgstr "Mobius"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Hable"
msgstr "Hable"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "ST 2094-40 (HDR10+)"
msgstr "ST 2094-40 (HDR10+)"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "ST 2094-10"
msgstr "ST 2094-10"

#. Choice (HDR > HDR Output > Tone Mapping Function)
#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Clip"
msgstr "Abschneiden"

#. Choice (HDR > HDR Output > Tone Mapping Function)
#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Linear"
msgstr "Linear"

#. Choice (HDR > HDR Output > Tone Mapping Function)
msgid "Linear Light"
msgstr "Lineares Licht"

#. Setting name (HDR > HDR Output)
msgid "Gamut Mapping Function"
msgstr "Funktion für Gamut Mapping"

#. Setting description (HDR > HDR Output > Gamut Mapping Function)
msgid "Map source colors into the output display's supported color gamut."
msgstr ""
"Überführt die Quellfarben in den unterstützten Farbumfang des "
"Ausgabebildschirms."

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Default (libplacebo)"
msgstr "Standard (libplacebo)"

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Softclip"
msgstr "Softclip"

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Desaturate"
msgstr "Entsättigen"

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Darken"
msgstr "Abdunkeln"

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Absolute Colorimetric"
msgstr "Absolut farbmetrisch"

#. Choice (HDR > HDR Output > Gamut Mapping Function)
msgid "Highlight Out-of-Gamut"
msgstr "Farben außerhalb des Farbumfangs hervorheben"

#. Setting name (HDR > HDR Output)
msgid "Show Clipping"
msgstr "Übersteuerung anzeigen"

#. Setting description (HDR > HDR Output > Show Clipping)
msgid ""
"Highlight values outside the target range to help evaluate mapping settings."
msgstr ""
"Hebt Werte außerhalb des Zielbereichs hervor, um die "
"Umrechnungseinstellungen zu beurteilen."

#. Setting name (HDR > HDR Output)
msgid "RTX Video HDR"
msgstr "RTX Video HDR"

#. Setting description (HDR > HDR Output > RTX Video HDR)
msgid ""
"AI conversion of SDR videos to HDR by the NVIDIA driver. Needs Windows HDR, "
"an RTX GPU and RTX Video HDR on in the NVIDIA app, where brightness is set."
msgstr ""
"Umrechnung von SDR in HDR durch die KI im Grafiktreiber von NVIDIA. Benötigt "
"aktiviertes HDR in Windows, eine RTX-GPU und aktiviertes RTX Video HDR in "
"der NVIDIA App. Die Helligkeit wird dort eingestellt."

#. Section heading (HDR)
msgid "HDR Peak Detection"
msgstr "Erkennung der Spitzenhelligkeit für HDR"

#. Setting name (HDR > HDR Peak Detection)
msgid "Enable Peak Detection"
msgstr "Spitzenhelligkeitserkennung aktivieren"

#. Setting description (HDR > HDR Peak Detection > Enable Peak Detection)
msgid "Measure scene brightness to adapt HDR tone mapping to the video."
msgstr ""
"Misst die Szenenhelligkeit, um das Tone Mapping für HDR an das Video "
"anzupassen."

#. Setting name (HDR > HDR Peak Detection)
msgid "Allow Delayed Peak Detection"
msgstr "Verzögerte Spitzenhelligkeitserkennung zulassen"

#. Setting description (HDR > HDR Peak Detection > Allow Delayed Peak Detection)
msgid ""
"Use a delayed brightness measurement to reduce synchronization overhead."
msgstr ""
"Verwendet eine verzögerte Helligkeitsmessung, um den "
"Synchronisierungsaufwand zu verringern."

#. Setting name (HDR > HDR Peak Detection)
msgid "Smoothing Period"
msgstr "Glättungszeitraum"

#. Setting description (HDR > HDR Peak Detection > Smoothing Period)
msgid ""
"Smooth peak measurements over time. Higher values make adaptation slower."
msgstr ""
"Glättet die Messwerte der Spitzenhelligkeit über die Zeit. Höhere Werte "
"verlangsamen die Anpassung."

#. Setting name (HDR > HDR Peak Detection)
msgid "Scene Threshold Low"
msgstr "Untere Szenenwechselschwelle"

#. Setting description (HDR > HDR Peak Detection > Scene Threshold Low)
msgid ""
"Lower scene-change threshold. Together with High, controls how quickly peak "
"detection reacts."
msgstr ""
"Untere Schwelle für Szenenwechsel. Bestimmt zusammen mit der oberen "
"Schwelle, wie schnell die Spitzenhelligkeitserkennung reagiert."

#. Setting name (HDR > HDR Peak Detection)
msgid "Scene Threshold High"
msgstr "Obere Szenenwechselschwelle"

#. Setting description (HDR > HDR Peak Detection > Scene Threshold High)
msgid "Upper scene-change threshold. Must not be below the Low threshold."
msgstr ""
"Obere Schwelle für Szenenwechsel. Darf nicht unter der unteren Schwelle "
"liegen."

#. Setting name (HDR > HDR Peak Detection)
msgid "Percentile"
msgstr "Perzentil"

#. Setting description (HDR > HDR Peak Detection > Percentile)
msgid ""
"Use a brightness percentile instead of the brightest individual pixel. 100 "
"uses the maximum."
msgstr ""
"Verwendet ein Helligkeitsperzentil statt des hellsten einzelnen Pixels. 100 "
"verwendet das Maximum."

#. Setting name (HDR > HDR Peak Detection)
msgid "Black Cutoff"
msgstr "Schwarzuntergrenze"

#. Setting description (HDR > HDR Peak Detection > Black Cutoff)
msgid "Exclude very dark pixels from HDR peak-detection statistics."
msgstr ""
"Schließt sehr dunkle Pixel aus der Statistik zur Erkennung der "
"Spitzenhelligkeit in HDR aus."

#. Section heading (HDR)
msgid "Tone Mapping Knee"
msgstr "Knickpunkt des Tone Mappings"

#. Setting name (HDR > Tone Mapping Knee)
msgid "Knee Adaptation"
msgstr "Knickpunktanpassung"

#. Setting description (HDR > Tone Mapping Knee > Knee Adaptation)
msgid "Adapt the knee to scene brightness. Used by ST 2094 and Spline."
msgstr ""
"Passt den Knickpunkt an die Szenenhelligkeit an. Wird von ST 2094 und Spline "
"verwendet."

#. Setting name (HDR > Tone Mapping Knee)
msgid "Knee Minimum"
msgstr "Minimaler Knickpunkt"

#. Setting description (HDR > Tone Mapping Knee > Knee Minimum)
msgid "Lower bound for the adaptive knee, in PQ-normalized space."
msgstr ""
"Untergrenze des adaptiven Knickpunkts im normalisierten PQ-Wertebereich."

#. Setting name (HDR > Tone Mapping Knee)
msgid "Knee Maximum"
msgstr "Maximaler Knickpunkt"

#. Setting description (HDR > Tone Mapping Knee > Knee Maximum)
msgid "Upper bound for the adaptive knee, in PQ-normalized space."
msgstr ""
"Obergrenze des adaptiven Knickpunkts im normalisierten PQ-Wertebereich."

#. Setting name (HDR > Tone Mapping Knee)
msgid "Knee Default"
msgstr "Standardknickpunkt"

#. Setting description (HDR > Tone Mapping Knee > Knee Default)
msgid ""
"Knee used when average scene brightness is unavailable. Keep within "
"Minimum / Maximum."
msgstr ""
"Verwendeter Knickpunkt, wenn die mittlere Szenenhelligkeit nicht verfügbar "
"ist. Innerhalb von Minimum und Maximum halten."

#. Setting name (HDR > Tone Mapping Knee)
msgid "BT.2390 Knee Offset"
msgstr "Knickpunktversatz für BT.2390"

#. Setting description (HDR > Tone Mapping Knee > BT.2390 Knee Offset)
msgid ""
"BT.2390 shoulder offset. The specification uses 0.5; libplacebo defaults to "
"1."
msgstr ""
"Versatz der Schulter für BT.2390. Die Spezifikation verwendet 0,5; der "
"Standardwert von libplacebo ist 1."

#. Section heading (HDR)
msgid "Tone Mapping Constants"
msgstr "Konstanten für Tone Mapping"

#. Setting name (HDR > Tone Mapping Constants)
msgid "Spline Slope Tuning"
msgstr "Steigungsanpassung für Spline"

#. Setting description (HDR > Tone Mapping Constants > Spline Slope Tuning)
msgid "Strength of scene-dependent Spline slope adjustment."
msgstr "Stärke der szenenabhängigen Anpassung der Steigung für Spline."

#. Setting name (HDR > Tone Mapping Constants)
msgid "Spline Slope Offset"
msgstr "Steigungsversatz für Spline"

#. Setting description (HDR > Tone Mapping Constants > Spline Slope Offset)
msgid "Offset for Spline slope adjustment."
msgstr "Versatz für die Anpassung der Steigung für Spline."

#. Setting name (HDR > Tone Mapping Constants)
msgid "Spline Contrast"
msgstr "Kontrast für Spline"

#. Setting description (HDR > Tone Mapping Constants > Spline Contrast)
msgid "Spline contrast around the knee. Only affects the Spline function."
msgstr "Kontrast um den Knickpunkt. Wirkt nur auf die Funktion Spline."

#. Setting name (HDR > Tone Mapping Constants)
msgid "Reinhard Contrast"
msgstr "Kontrast für Reinhard"

#. Setting description (HDR > Tone Mapping Constants > Reinhard Contrast)
msgid "Contrast for Reinhard. Larger values increase contrast."
msgstr "Kontrast für Reinhard. Größere Werte erhöhen den Kontrast."

#. Setting name (HDR > Tone Mapping Constants)
msgid "Mobius / Gamma Knee"
msgstr "Knickpunkt für Mobius / Gamma"

#. Setting description (HDR > Tone Mapping Constants > Mobius / Gamma Knee)
msgid "Transition point for Mobius and Gamma tone mapping."
msgstr "Übergangspunkt für Tone Mapping mit Mobius und Gamma."

#. Setting name (HDR > Tone Mapping Constants)
msgid "Linear Exposure"
msgstr "Lineare Belichtung"

#. Setting description (HDR > Tone Mapping Constants > Linear Exposure)
msgid ""
"Exposure multiplier for Linear and Linear Light tone mapping. 1 is unchanged."
msgstr ""
"Belichtungsmultiplikator für Tone Mapping mit Linear und Lineares Licht. 1 "
"lässt die Belichtung unverändert."

#. Section heading (HDR)
#. Setting name (HDR > Contrast Recovery)
msgid "Contrast Recovery"
msgstr "Kontrastwiederherstellung"

#. Setting description (HDR > Contrast Recovery > Contrast Recovery)
msgid "Recover local contrast lost in tone mapping. 0 disables recovery."
msgstr ""
"Stellt lokalen Kontrast wieder her, der beim Tone Mapping verloren geht. 0 "
"deaktiviert die Wiederherstellung."

#. Setting name (HDR > Contrast Recovery)
msgid "Contrast Smoothness"
msgstr "Kontrastglättung"

#. Setting description (HDR > Contrast Recovery > Contrast Smoothness)
msgid ""
"Spatial scale for contrast recovery. Used only when recovery is above 0."
msgstr ""
"Räumlicher Maßstab für die Kontrastwiederherstellung. Wird nur verwendet, "
"wenn die Wiederherstellung über 0 liegt."

#. Section heading (HDR)
msgid "Gamut Mapping Constants"
msgstr "Konstanten für Gamut Mapping"

#. Setting name (HDR > Gamut Mapping Constants)
msgid "Perceptual Deadzone"
msgstr "Wahrnehmungsbezogener Schonbereich"

#. Setting description (HDR > Gamut Mapping Constants > Perceptual Deadzone)
msgid ""
"Protect colors already inside the target gamut from perceptual remapping."
msgstr ""
"Schützt Farben, die bereits innerhalb des Zielfarbumfangs liegen, vor "
"wahrnehmungsorientierter Neuzuordnung."

#. Setting name (HDR > Gamut Mapping Constants)
msgid "Perceptual Strength"
msgstr "Stärke der Wahrnehmungsanpassung"

#. Setting description (HDR > Gamut Mapping Constants > Perceptual Strength)
msgid "Balance perceptual gamut compression and colorimetric mapping."
msgstr ""
"Gewichtet die wahrnehmungsorientierte Farbumfangskompression gegenüber der "
"farbmetrischen Zuordnung."

#. Setting name (HDR > Gamut Mapping Constants)
msgid "Colorimetric Gamma"
msgstr "Farbmetrisches Gamma"

#. Setting description (HDR > Gamut Mapping Constants > Colorimetric Gamma)
msgid ""
"Gamma used for colorimetric clipping; affects Relative and related mapping."
msgstr ""
"Gamma für die farbmetrische Begrenzung. Wirkt auf Relativ und verwandte "
"Umrechnungsverfahren."

#. Setting name (HDR > Gamut Mapping Constants)
msgid "Softclip Knee"
msgstr "Knickpunkt für Softclip"

#. Setting description (HDR > Gamut Mapping Constants > Softclip Knee)
msgid "Saturation threshold where soft clipping starts."
msgstr "Sättigungsschwelle, ab der die weiche Begrenzung beginnt."

#. Setting name (HDR > Gamut Mapping Constants)
msgid "Softclip Desaturation"
msgstr "Entsättigung für Softclip"

#. Setting description (HDR > Gamut Mapping Constants > Softclip Desaturation)
msgid "Desaturation near the gamut boundary when using Softclip."
msgstr "Entsättigung nahe der Farbumfangsgrenze bei Verwendung von Softclip."

#. Section heading (HDR)
msgid "Mapping LUT Quality"
msgstr "Qualität der LUTs für die Farbumrechnung"

#. Setting name (HDR > Mapping LUT Quality)
msgid "Gamut LUT Intensity Size"
msgstr "LUT für den Farbumfang: Auflösung der Intensitätsachse"

#. Setting description (HDR > Mapping LUT Quality > Gamut LUT Intensity Size)
msgid ""
"Internal gamut LUT resolution along intensity. 0 selects the library size."
msgstr ""
"Interne Auflösung der LUT für den Farbumfang entlang der Intensitätsachse. 0 "
"verwendet die Vorgabe der Bibliothek."

#. Setting name (HDR > Mapping LUT Quality)
msgid "Gamut LUT Chroma Size"
msgstr "LUT für den Farbumfang: Auflösung der Chromaachse"

#. Setting description (HDR > Mapping LUT Quality > Gamut LUT Chroma Size)
msgid "Internal gamut LUT resolution along chroma. 0 selects the library size."
msgstr ""
"Interne Auflösung der LUT für den Farbumfang entlang der Chromaachse. 0 "
"verwendet die Vorgabe der Bibliothek."

#. Setting name (HDR > Mapping LUT Quality)
msgid "Gamut LUT Hue Size"
msgstr "LUT für den Farbumfang: Auflösung der Farbtonachse"

#. Setting description (HDR > Mapping LUT Quality > Gamut LUT Hue Size)
msgid "Internal gamut LUT resolution along hue. 0 selects the library size."
msgstr ""
"Interne Auflösung der LUT für den Farbumfang entlang der Farbtonachse. 0 "
"verwendet die Vorgabe der Bibliothek."

#. Setting name (HDR > Mapping LUT Quality)
msgid "Tricubic Gamut Interpolation"
msgstr "Trikubische Interpolation des Farbumfangs"

#. Setting description (HDR > Mapping LUT Quality > Tricubic Gamut Interpolation)
msgid ""
"Use tricubic interpolation for the internal gamut LUT; costs additional GPU "
"work."
msgstr ""
"Verwendet trikubische Interpolation für die interne LUT für den Farbumfang. "
"Benötigt zusätzliche GPU-Rechenleistung."

#. Setting name (HDR > Mapping LUT Quality)
msgid "Tone Mapping LUT Size"
msgstr "Größe der LUT für Tone Mapping"

#. Setting description (HDR > Mapping LUT Quality > Tone Mapping LUT Size)
msgid "Internal tone curve lookup resolution. 0 selects the library size."
msgstr ""
"Interne Auflösung der LUT für die Tonwertkurve. 0 verwendet die Vorgabe der "
"Bibliothek."

#. Section heading (HDR)
msgid "Mapping Visualization"
msgstr "Visualisierung der Farbumrechnung"

#. Setting name (HDR > Mapping Visualization)
msgid "Force Tone Mapping LUT"
msgstr "LUT für Tone Mapping erzwingen"

#. Setting description (HDR > Mapping Visualization > Force Tone Mapping LUT)
msgid ""
"Use a lookup table even for tone curves that could be evaluated directly."
msgstr ""
"Verwendet auch für direkt berechenbare Tonwertkurven eine Nachschlagetabelle."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualize Mapping LUT"
msgstr "LUT für die Farbumrechnung visualisieren"

#. Setting description (HDR > Mapping Visualization > Visualize Mapping LUT)
msgid "Draw a diagnostic visualization over the video."
msgstr "Legt eine Diagnosevisualisierung über das Video."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Left"
msgstr "Visualisierung: Links"

#. Setting description (HDR > Mapping Visualization > Visualization Left)
msgid ""
"Left edge of the visualization in normalized output coordinates (0 to 1)."
msgstr ""
"Linker Rand der Visualisierung in normalisierten Ausgabekoordinaten (0 bis "
"1)."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Top"
msgstr "Visualisierung: Oben"

#. Setting description (HDR > Mapping Visualization > Visualization Top)
msgid ""
"Top edge of the visualization in normalized output coordinates (0 to 1)."
msgstr ""
"Oberer Rand der Visualisierung in normalisierten Ausgabekoordinaten (0 bis "
"1)."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Right"
msgstr "Visualisierung: Rechts"

#. Setting description (HDR > Mapping Visualization > Visualization Right)
msgid ""
"Right edge of the visualization in normalized output coordinates (0 to 1)."
msgstr ""
"Rechter Rand der Visualisierung in normalisierten Ausgabekoordinaten (0 bis "
"1)."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Bottom"
msgstr "Visualisierung: Unten"

#. Setting description (HDR > Mapping Visualization > Visualization Bottom)
msgid ""
"Bottom edge of the visualization in normalized output coordinates (0 to 1)."
msgstr ""
"Unterer Rand der Visualisierung in normalisierten Ausgabekoordinaten (0 bis "
"1)."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Hue (radians)"
msgstr "Visualisierung: Farbton (Radiant)"

#. Setting description (HDR > Mapping Visualization > Visualization Hue (radians))
msgid "Gamut visualization hue slice, from -pi to pi."
msgstr "Farbtonschnitt der Farbumfangsvisualisierung von -pi bis pi."

#. Setting name (HDR > Mapping Visualization)
msgid "Visualization Rotation (radians)"
msgstr "Visualisierung: Drehung (Radiant)"

#. Setting description (HDR > Mapping Visualization > Visualization Rotation (radians))
msgid "Gamut visualization angle, from 0 to pi/2."
msgstr "Winkel der Farbumfangsvisualisierung von 0 bis pi/2."

#. Section heading (HDR)
msgid "Expansion & Metadata"
msgstr "Erweiterung und Metadaten"

#. Setting name (HDR > Expansion & Metadata)
msgid "Inverse Tone Mapping"
msgstr "Inverses Tone Mapping"

#. Setting description (HDR > Expansion & Metadata > Inverse Tone Mapping)
msgid ""
"Allow expansion of SDR brightness into HDR. Requires a supporting tone curve."
msgstr ""
"Erlaubt die Erweiterung der Helligkeit von SDR auf HDR. Benötigt eine "
"unterstützte Tonwertkurve."

#. Setting name (HDR > Expansion & Metadata)
msgid "Gamut Expansion"
msgstr "Farbumfangserweiterung"

#. Setting description (HDR > Expansion & Metadata > Gamut Expansion)
msgid "Allow expansion into a wider display gamut."
msgstr "Erlaubt die Erweiterung auf einen größeren Bildschirmfarbumfang."

#. Setting name (HDR > Expansion & Metadata)
msgid "Tone Mapping Metadata"
msgstr "Metadaten für Tone Mapping"

