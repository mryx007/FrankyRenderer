#. Category
#. Category heading
#. Setting name (Shortcuts > )
msgid "General"
msgstr "Allgemein"

#. Category description
msgid ""
"Output precision, display mode switching, background and image analysis."
msgstr ""
"Ausgabepräzision, Wechsel des Anzeigemodus, Hintergrund und Bildanalyse."

#. Tab (General)
#. Section heading (General)
#. Setting name (Shortcuts > )
msgid "Output"
msgstr "Ausgabe"

#. Tab (General)
msgid "Background"
msgstr "Hintergrund"

#. Tab (General)
msgid "Themes"
msgstr "Designs"

#. Setting name (General > Output)
#. Setting name (Shortcuts > )
msgid "Output Texture Format"
msgstr "Ausgabe-Texturformat"

#. Setting description (General > Output > Output Texture Format)
msgid ""
"Precision of the final output texture. Auto follows the renderer's output "
"selection."
msgstr ""
"Präzision der endgültigen Ausgabe-Textur. 'Auto' folgt der Ausgabeauswahl "
"des Renderers."

#. Choice (General > Output > Output Texture Format)
#. Setting name (Shortcuts > )
msgid "Auto (libplacebo)"
msgstr "Auto (libplacebo)"

#. Choice (General > Output > Output Texture Format)
#. Setting name (Shortcuts > )
msgid "8-bit Integer (SDR)"
msgstr "8-bit Integer (SDR)"

#. Choice (General > Output > Output Texture Format)
#. Setting name (Shortcuts > )
msgid "Prefer 10-bit Integer"
msgstr "10-bit Integer bevorzugen"

#. Choice (General > Output > Output Texture Format)
#. Setting name (Shortcuts > )
msgid "Prefer 16-bit Float"
msgstr "16-bit Float bevorzugen"

#. Setting name (General > Output)
#. Setting name (Shortcuts > )
msgid "RGB Output Levels"
msgstr "Ausgabebereich für RGB"

#. Setting description (General > Output > RGB Output Levels)
msgid "Match the RGB range used by the display and GPU driver."
msgstr "RGB-Bereich an Einstellung des Displays und GPU-Treiber anpassen."

#. Choice (General > Output > RGB Output Levels)
#. Setting name (Shortcuts > )
msgid "Auto (Output)"
msgstr "Auto (Ausgabe)"

#. Choice (General > Output > RGB Output Levels)
#. Setting name (Shortcuts > )
msgid "PC Levels (0–255)"
msgstr "Voll (PC, 0-255)"

#. Choice (General > Output > RGB Output Levels)
#. Setting name (Shortcuts > )
msgid "TV Levels (16–235)"
msgstr "Begrenzt (TV, 16-235)"

#. Setting name (General > Output)
#. Setting name (Shortcuts > )
msgid "Dither Target Bit Depth"
msgstr "Ziel-Bittiefe für Dithering"

#. Setting description (General > Output > Dither Target Bit Depth)
msgid "Dither to the actual output precision; Auto follows the output texture."
msgstr ""
"Dithering an die tatsächliche Ausgabepräzision anpassen; 'Auto' folgt der "
"Ausgabetextur."

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "Auto (Output Texture)"
msgstr "Auto (Ausgabe-Textur)"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "4 Bit"
msgstr "4 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "5 Bit"
msgstr "5 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "6 Bit"
msgstr "6 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "8 Bit"
msgstr "8 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "10 Bit"
msgstr "10 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "12 Bit"
msgstr "12 Bit"

#. Choice (General > Output > Dither Target Bit Depth)
#. Setting name (Shortcuts > )
msgid "16 Bit"
msgstr "16 Bit"

#. Setting name (General > Output)
#. Setting name (Shortcuts > )
msgid "Max Frames in Flight"
msgstr "Maximal gleichzeitig verarbeitete Bilder"

#. Setting description (General > Output > Max Frames in Flight)
msgid "0 retains the device default. More buffering increases latency."
msgstr ""
"0 verwendet den Standardwert des Geräts. Ein größerer Puffer erhöht die "
"Latenz."

#. Section heading (General)
#. Setting name (General > Image Analysis)
#. Setting name (Shortcuts > )
msgid "Image Analysis"
msgstr "Bildanalyse"

#. Setting description (General > Image Analysis > Image Analysis)
msgid ""
"Waveform, histogram, RGB parade, false color and gray ramp, before or after "
"color mapping, without subtitles."
msgstr ""
"Wellenform, Histogramm, RGB-Parade, Falschfarben und Grauverlauf, vor oder "
"nach der Farbumrechnung, ohne Untertitel."

#. Setting name (General > Image Analysis)
#. Setting name (Shortcuts > )
msgid "Statistics in Video Area"
msgstr "Statistik im Bildbereich"

#. Setting description (General > Image Analysis > Statistics in Video Area)
msgid ""
"Ctrl+J statistics and image analysis sit on the picture, not in black bars."
msgstr ""
"Ctrl+J-Statistik und Bildanalyse stehen im Bild, nicht in schwarzen Balken."

#. Section heading (General)
#. Setting name (Shortcuts > )
msgid "Display Mode"
msgstr "Anzeigemodus"

#. Section description (General > Display Mode)
msgid ""
"Switches the display to a listed mode matching the video frame rate in "
"fullscreen and restores it when leaving fullscreen or stopping."
msgstr ""
"Wechselt im Vollbild zu einem aufgeführten Anzeigemodus, der zur Bildrate "
"des Videos passt. Beim Verlassen des Vollbilds oder Beenden der Wiedergabe "
"wird der vorherige Modus wiederhergestellt."

#. Setting name (General > Display Mode)
#. Setting name (Shortcuts > )
msgid "Switch Display Mode in Fullscreen"
msgstr "Anzeigemodus im Vollbild wechseln"

#. Setting description (General > Display Mode > Switch Display Mode in Fullscreen)
msgid ""
"Uses the listed mode whose refresh rate is the lowest whole multiple of the "
"frame rate. Only for this display."
msgstr ""
"Nimmt den Modus aus der Liste, dessen Bildwiederholrate das kleinste ganze "
"Vielfache der Bildrate ist. Nur für dieses Display."

#. Setting name (General > Display Mode)
msgid "Allowed Modes"
msgstr "Zulässige Modi"

#. Setting description (General > Display Mode > Allowed Modes)
msgid ""
"Comma-separated, e.g. 2160p23, or just 23 to keep the resolution. 23, 29 and "
"59 mean 23.976, 29.97 and 59.94 Hz."
msgstr ""
"Durch Kommas getrennt, z. B. 2160p23. Nur 23 behält die Auflösung bei. 23, "
"29 und 59 stehen für 23,976, 29,97 und 59,94 Hz."

#. Input hint (General > Display Mode > Allowed Modes)
msgid "e.g. 2160p23, 2160p24, 2160p60"
msgstr "z. B. 2160p23, 2160p24, 2160p60"

#. Input error (General > Display Mode > Allowed Modes)
msgid ""
"Enter display modes like 2160p23, 2160p24, 2160p50, 2160p60 or just 23, 24, "
"60."
msgstr ""
"Anzeigemodi wie 2160p23, 2160p24, 2160p50, 2160p60 oder nur 23, 24, 60 "
"eingeben."

#. Setting name (General > Display Mode)
#. Setting name (Shortcuts > )
msgid "Pause After Switching (seconds)"
msgstr "Pause nach dem Wechsel (Sekunden)"

#. Setting description (General > Display Mode > Pause After Switching (seconds))
msgid "Pauses playback while the display resynchronises after a mode change."
msgstr ""
"Pausiert die Wiedergabe, während sich der Bildschirm nach einem Moduswechsel "
"neu synchronisiert."

#. Section heading (General)
#. Setting name (Shortcuts > )
msgid "Background & Transparency"
msgstr "Hintergrund und Transparenz"

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Background Red"
msgstr "Hintergrund: Rot"

#. Setting description (General > Background & Transparency > Background Red)
msgid ""
"Red channel for uncovered borders and transparent pixels. RGB range: 0 to 1."
msgstr ""
"Rotanteil für unbedeckte Ränder und transparente Pixel. RGB-Bereich: 0 bis 1."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Background Green"
msgstr "Hintergrund: Grün"

#. Setting description (General > Background & Transparency > Background Green)
msgid ""
"Green channel for uncovered borders and transparent pixels. RGB range: 0 to "
"1."
msgstr ""
"Grünanteil für unbedeckte Ränder und transparente Pixel. RGB-Bereich: 0 bis "
"1."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Background Blue"
msgstr "Hintergrund: Blau"

#. Setting description (General > Background & Transparency > Background Blue)
msgid ""
"Blue channel for uncovered borders and transparent pixels. RGB range: 0 to 1."
msgstr ""
"Blauanteil für unbedeckte Ränder und transparente Pixel. RGB-Bereich: 0 bis "
"1."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Background Transparency"
msgstr "Hintergrundtransparenz"

#. Setting description (General > Background & Transparency > Background Transparency)
msgid ""
"0 is opaque; 1 is transparent. Changes rendered alpha, not Windows desktop/"
"window transparency."
msgstr ""
"0 ist undurchsichtig, 1 ist transparent. Ändert den gerenderten Alphawert, "
"nicht die Transparenz des Desktops oder Fensters in Windows."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Corner Rounding"
msgstr "Eckenrundung"

#. Setting description (General > Background & Transparency > Corner Rounding)
msgid ""
"Relative amount of rounded video corners. 0 keeps square corners; 1 applies "
"the maximum rounding."
msgstr ""
"Relative Rundung der Videoecken. 0 behält rechteckige Ecken bei, 1 wendet "
"die maximale Rundung an."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Skip Target Clearing"
msgstr "Löschen der Ausgabefläche überspringen"

#. Setting description (General > Background & Transparency > Skip Target Clearing)
msgid ""
"Skips clearing the borders around the picture. Old pixels may remain there. "
"Default: Off."
msgstr ""
"Lässt das Löschen der Ränder um das Bild aus. Dort können alte Pixel stehen "
"bleiben. Standard: Aus."

#. Choice (General > Background & Transparency > Skip Target Clearing)
#. Choice (General > Background & Transparency > Blend Against Tiles)
#. Choice (Scaling > Filters > Skip Downscale Anti-Aliasing)
msgid "Default (Off)"
msgstr "Standard (Aus)"

#. Choice (General > Background & Transparency > Skip Target Clearing)
#. Choice (General > Background & Transparency > Blend Against Tiles)
#. Choice (Processing > Deinterlacing > Algorithm)
msgid "Off"
msgstr "Aus"

#. Choice (General > Background & Transparency > Skip Target Clearing)
#. Choice (General > Background & Transparency > Blend Against Tiles)
#. Choice (Scaling > Filters > Skip Downscale Anti-Aliasing)
msgid "On"
msgstr "Ein"

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Blend Against Tiles"
msgstr "Schachbretthintergrund verwenden"

#. Setting description (General > Background & Transparency > Blend Against Tiles)
msgid ""
"Composite transparent image regions onto a checkerboard. Default is Off. "
"Tile colors do not recolor opaque video."
msgstr ""
"Stellt transparente Bildbereiche vor einem Schachbrettmuster dar. Standard: "
"Aus. Die Musterfarben verändern keine undurchsichtigen Videobereiche."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Light Tile Red"
msgstr "Helle Felder: Rot"

#. Setting description (General > Background & Transparency > Light Tile Red)
msgid ""
"Red channel of the light checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Rotanteil der hellen Schachbrettfelder. Wird mit dem Schachbretthintergrund "
"verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Light Tile Green"
msgstr "Helle Felder: Grün"

#. Setting description (General > Background & Transparency > Light Tile Green)
msgid ""
"Green channel of the light checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Grünanteil der hellen Schachbrettfelder. Wird mit dem Schachbretthintergrund "
"verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Light Tile Blue"
msgstr "Helle Felder: Blau"

#. Setting description (General > Background & Transparency > Light Tile Blue)
msgid ""
"Blue channel of the light checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Blauanteil der hellen Schachbrettfelder. Wird mit dem Schachbretthintergrund "
"verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Dark Tile Red"
msgstr "Dunkle Felder: Rot"

#. Setting description (General > Background & Transparency > Dark Tile Red)
msgid ""
"Red channel of the dark checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Rotanteil der dunklen Schachbrettfelder. Wird mit dem Schachbretthintergrund "
"verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Dark Tile Green"
msgstr "Dunkle Felder: Grün"

#. Setting description (General > Background & Transparency > Dark Tile Green)
msgid ""
"Green channel of the dark checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Grünanteil der dunklen Schachbrettfelder. Wird mit dem "
"Schachbretthintergrund verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Dark Tile Blue"
msgstr "Dunkle Felder: Blau"

#. Setting description (General > Background & Transparency > Dark Tile Blue)
msgid ""
"Blue channel of the dark checkerboard tiles. Used with Blend Against Tiles."
msgstr ""
"Blauanteil der dunklen Schachbrettfelder. Wird mit dem "
"Schachbretthintergrund verwendet."

#. Setting name (General > Background & Transparency)
#. Setting name (Shortcuts > )
msgid "Tile Size (pixels)"
msgstr "Mustergröße (Pixel)"

#. Setting description (General > Background & Transparency > Tile Size (pixels))
msgid ""
"Checkerboard repeat size in output pixels. Default: 32; manual range: 2 to "
"256."
msgstr ""
"Wiederholungsgröße des Schachbrettmusters in Ausgabepixeln. Standard: 32; "
"manueller Bereich: 2 bis 256."

#. Section heading (General)
#. Setting name (Shortcuts > )
msgid "Diagnostics"
msgstr "Diagnose"

#. Setting name (General > Diagnostics)
msgid "Diagnostic Log"
msgstr "Diagnoseprotokoll"

#. Setting description (General > Diagnostics > Diagnostic Log)
msgid ""
"Records the next start of the player for a bug report, then turns itself off."
msgstr ""
"Zeichnet den nächsten Start des Players für einen Fehlerbericht auf und "
"schaltet sich danach selbst aus."

#. Setting name (General > Diagnostics)
msgid "Save Report"
msgstr "Bericht speichern"

#. Setting description (General > Diagnostics > Save Report)
msgid "Saves a report for a bug report on the desktop."
msgstr "Speichert einen Bericht für eine Fehlermeldung auf dem Desktop."

#. Button (General > Diagnostics > Save Report)
msgid "Save"
msgstr "Speichern"

#. Section heading (General)
msgid "Menu Appearance"
msgstr "Menügestaltung"

#. Section description (General > Menu Appearance)
msgid "Colours of this settings window. Applies immediately."
msgstr "Farben dieses Einstellungsfensters. Wird sofort angewendet."

#. Setting name (General > Menu Appearance)
msgid "Theme"
msgstr "Design"

#. Choice (General > Menu Appearance > Theme)
msgid "Indigo"
msgstr "Indigo"

#. Choice (General > Menu Appearance > Theme)
msgid "Graphite"
msgstr "Graphit"

#. Choice (General > Menu Appearance > Theme)
msgid "Midnight"
msgstr "Mitternacht"

#. Choice (General > Menu Appearance > Theme)
msgid "Ocean"
msgstr "Ozean"

#. Choice (General > Menu Appearance > Theme)
msgid "Light"
msgstr "Hell"

#. Setting name (General > Menu Appearance)
msgid "Accent Color"
msgstr "Akzentfarbe"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Violet"
msgstr "Violett"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Blue"
msgstr "Blau"

#. Choice (General > Menu Appearance > Accent Color)
msgid "Teal"
msgstr "Türkis"

#. Choice (General > Menu Appearance > Accent Color)
