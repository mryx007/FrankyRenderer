#. Setting description (Profiles > Displays > All Displays)
msgid "Off: only on the displays switched on below."
msgstr "Aus: nur auf den unten eingeschalteten Bildschirmen."

#. Section heading (Profiles)
#. Setting name (Profiles > New Profile)
msgid "New Profile"
msgstr "Neues Profil"

#. Section description (Profiles > New Profile)
msgid ""
"Own settings for videos from chosen folders, e.g. other scaling for anime."
msgstr ""
"Eigene Einstellungen für Videos aus ausgewählten Ordnern, z. B. andere "
"Skalierung für Anime."

#. Setting description (Profiles > New Profile > New Profile)
msgid "Adds an empty profile in its own tab."
msgstr "Legt ein leeres Profil in einem eigenen Reiter an."

#. Button (Profiles > New Profile > New Profile)
msgid "Create"
msgstr "Erstellen"

#. Category
#. Category heading
msgid "Shortcuts"
msgstr "Tastenkürzel"

#. Category description
msgid ""
"Keys for the playing video. Open a group, click a field and press the keys."
msgstr ""
"Tasten für das laufende Video. Gruppe öffnen, Feld anklicken und Tasten "
"drücken."

#. Setting name (Shortcuts > )
#. Menu text; keep %d and %s placeholders
msgid "Reset Shortcuts"
msgstr "Tastenkürzel zurücksetzen"

#. Setting name (Shortcuts > )
msgid "Renderer"
msgstr "Renderer"

#. Setting name (Shortcuts > )
msgid "Statistics"
msgstr "Statistik"

#. Setting description (Shortcuts >  > Statistics)
msgid "Shows or hides the statistics."
msgstr "Blendet die Statistik ein oder aus."

#. Setting name (Shortcuts > )
msgid "All Shaders Off / Back On"
msgstr "Alle Shader aus / wieder an"

#. Setting description (Shortcuts >  > All Shaders Off / Back On)
msgid "Turns all shaders off; pressed again, back on."
msgstr "Schaltet alle Shader aus, erneut gedrückt wieder ein."

#. Setting name (Shortcuts > )
msgid "Next Quality Preset"
msgstr "Nächste Qualitätsstufe"

#. Setting description (Shortcuts >  > Next Quality Preset)
msgid "Switches to the next quality preset."
msgstr "Wechselt zur nächsten Qualitätsstufe."

#. Setting name (Shortcuts > )
msgid "Next Profile"
msgstr "Nächstes Profil"

#. Setting description (Shortcuts >  > Next Profile)
msgid "Switches this file to the next profile."
msgstr "Wechselt für diese Datei zum nächsten Profil."

#. Setting name (Shortcuts > )
msgid "Reset Picture Controls"
msgstr "Bildregler zurücksetzen"

#. Setting description (Shortcuts >  > Reset Picture Controls)
msgid "Sets brightness, contrast, saturation and gamma back to neutral."
msgstr "Setzt Helligkeit, Kontrast, Sättigung und Gamma auf neutral zurück."

#. Setting name (Shortcuts > )
msgid "Reset Statistics"
msgstr "Statistik zurücksetzen"

#. Setting description (Shortcuts >  > Reset Statistics)
msgid "Counters, averages and peaks start from zero."
msgstr "Zähler, Mittelwerte und Spitzen beginnen bei null."

#. Setting name (Shortcuts > )
msgid "Next"
msgstr "Nächster Wert"

#. Setting description (Shortcuts >  > Next)
msgid "Next value; after the last one, the first again."
msgstr "Nächster Wert, nach dem letzten wieder der erste."

#. Setting description (Shortcuts >  > Auto (libplacebo))
#. Setting description (Shortcuts >  > 8-bit Integer (SDR))
#. Setting description (Shortcuts >  > Prefer 10-bit Integer)
msgid "Sets exactly this value."
msgstr "Setzt genau diesen Wert."

#. Setting name (Shortcuts > )
msgid "Increase"
msgstr "Erhöhen"

#. Setting description (Shortcuts >  > Increase)
msgid "Raises the value by %s."
msgstr "Erhöht den Wert um %s."

#. Setting name (Shortcuts > )
msgid "Decrease"
msgstr "Verringern"

#. Setting description (Shortcuts >  > Decrease)
msgid "Lowers the value by %s."
msgstr "Verringert den Wert um %s."

#. Setting description (Shortcuts >  > Image Analysis)
#. Setting description (Shortcuts >  > Statistics in Video Area)
#. Setting description (Shortcuts >  > Switch Display Mode in Fullscreen)
msgid "Switches on or off; each press changes it."
msgstr "Schaltet ein oder aus, jeder Druck wechselt."

