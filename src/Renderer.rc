STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Debanding",150,12,8,470,16
 LTEXT "Reduce visible steps in gradients. Default means a fixed library value.",151,12,27,474,12
 GROUPBOX "Debanding Controls",-1,8,46,480,218
 LTEXT "Debanding",-1,18,62,112,12
 COMBOBOX 220,136,59,100,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Choose On to activate. Values can be edited while Off.",705,248,59,226,28
 LTEXT "Iterations",-1,18,105,110,12
 EDITTEXT 210,136,102,100,14,ES_AUTOHSCROLL
 LTEXT "Default = 1; manual: 0 to 16",711,18,122,108,12
 LTEXT "Number of passes. 0 adds grain only. More passes cost GPU time; above 4 rarely helps.",-1,248,102,226,34
 LTEXT "Threshold",-1,18,145,110,12
 EDITTEXT 211,136,142,100,14,ES_AUTOHSCROLL
 LTEXT "Default = 3; manual: 0 to 1000",712,18,162,108,12
 LTEXT "Higher values remove stronger banding, but can smooth away fine detail.",-1,248,142,226,30
 LTEXT "Radius",-1,18,185,110,12
 EDITTEXT 212,136,182,100,14,ES_AUTOHSCROLL
 LTEXT "Default = 16; manual: 0 to 1000",713,18,202,108,12
 LTEXT "Initial sample radius. Larger values cover wider gradients; smaller values smooth more aggressively.",-1,248,182,226,34
 LTEXT "Grain",-1,18,225,110,12
 EDITTEXT 213,136,222,100,14,ES_AUTOHSCROLL
 LTEXT "Default = 4; manual: 0 to 1000",714,18,242,108,12
 LTEXT "Noise to mask remaining banding. 0 adds none. HDR can amplify grain brightness; use modest values.",-1,248,222,226,34
 PUSHBUTTON "Reset Values to Default",700,18,275,144,18,WS_TABSTOP
 LTEXT "Resets the four values only; enable state is preserved. Changes take effect immediately.",-1,176,278,300,16
 GROUPBOX "Grain Neutral",-1,8,306,480,42
 LTEXT "Managed by libplacebo: it derives the neutral channel values from the input signal. Manual overrides are replaced by the renderer.",-1,18,320,458,26
END
