{
  "source": "https://github.com/clsid2/FFmpeg",
  "commit": "f67e27d31cc4da05d463d57300bc8f4358e4ef6b",
  "use": "Enhancement-layer decoding and local file reading only; no replacement DirectShow decoder",
  "license": "LGPL-2.1-or-later",
  "libraries": [
    "libavcodec/avcodec-lav-63.dll",
    "libavformat/avformat-lav-63.dll",
    "libavutil/avutil-lav-61.dll"
  ],
  "configure": [
    "--target-os=mingw32",
    "--arch=x86_64",
    "--cc=gcc",
    "--enable-shared",
    "--disable-static",
    "--build-suffix=-lav",
    "--disable-programs",
    "--disable-doc",
    "--disable-debug",
    "--disable-everything",
    "--disable-autodetect",
    "--disable-network",
    "--disable-avdevice",
    "--disable-avfilter",
    "--disable-swscale",
    "--disable-swresample",
    "--enable-w32threads",
    "--enable-d3d11va",
    "--enable-zlib",
    "--enable-decoder=hevc",
    "--enable-hwaccel=hevc_d3d11va,hevc_d3d11va2",
    "--enable-parser=hevc",
    "--enable-demuxer=matroska,mov,mpegts",
    "--enable-protocol=file"
  ]
}
